{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ],
      "bindings": [
        {
          "type": "service",
          "service": "sudarshan-ai-detector",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "sudarshan-ai-detector": {
      "root": "sudarshan-ai-detector",
      "framework": "fastapi",
      "entrypoint": "scripts/api.py",
      "rewrites": [
        {
          "source": "/api/:path(.*)?",
          "destination": "/:path"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "sudarshan-ai-detector"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
